APP_NAME=VaultLogix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vaultlogix
DB_USERNAME=root
DB_PASSWORD=Data500%

# Cache & Queue
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Sanctum / SPA
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# CORS
ALLOW_ORIGIN=*

# Mail (adjust for production)
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="VaultLogix"

# Production notes
# - Set APP_ENV=production, APP_DEBUG=false in production
# - Set APP_URL to your public API URL (e.g., https://api.example.com)
# - Use strong DB credentials and configure Redis for CACHE_DRIVER/QUEUE if applicable
